---
import "../styles/paper.css";

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  navItems?: NavItem[];
}

const { title, description = "", navItems = [] } = Astro.props;
const withBase = (path: string) => {
  if (path.startsWith("http") || path.startsWith("#")) {
    return path;
  }
  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
};
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="paper-shell">
      <aside class="paper-nav" aria-label="Paper sections">
        <a class="paper-nav__home" href={withBase("paper/")}>CPD Companion</a>
        {navItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </aside>
      <main class="paper-main">
        <aside class="source-namespace-banner">
          Source namespace: CPD paper source text. The English paper text and translated text describe the CPD paper.
          They are not claims that this repository has reproduced the paper or achieved the paper's reported benchmark
          results.
        </aside>
        <slot />
      </main>
    </div>
    <script is:inline>
      const markScrollableMath = () => {
        document.querySelectorAll(
          ".paper-block math, .figure-panel math, .equation-block math, .algorithm-block math, .table-block math",
        ).forEach((math) => {
          math.classList.remove("math-scroll");
          math.classList.remove("math-fraction");
          const container = math.closest(
            ".paper-block__original, .paper-block__translation, .figure-panel__caption, .equation-block__math, .algorithm-block__text, .table-block",
          );
          const parentWidth =
            container?.clientWidth || math.parentElement?.clientWidth || document.documentElement.clientWidth;
          if (math.querySelector("mfrac")) {
            math.classList.add("math-fraction");
          }
          if (math.scrollWidth > Math.min(parentWidth, window.innerWidth) + 1) {
            math.classList.add("math-scroll");
          }
        });
      };
      const markSourceSizedImages = () => {
        document.querySelectorAll(".figure-panel__image").forEach((image) => {
          if (!(image instanceof HTMLImageElement) || !image.naturalWidth) {
            return;
          }
          image.classList.remove("figure-panel__image--source-sized");
          image.classList.remove("figure-panel__image--wide-plot");
          image.style.removeProperty("--source-image-width");
          const imageRatio = image.naturalWidth / image.naturalHeight;
          const panelWidth = image.parentElement?.clientWidth || image.clientWidth;
          if (
            image.classList.contains("figure-panel__image--plot") &&
            imageRatio > 4 &&
            panelWidth < 700
          ) {
            image.style.setProperty(
              "--source-image-width",
              `${Math.min(image.naturalWidth, 900)}px`,
            );
            image.classList.add("figure-panel__image--wide-plot");
            return;
          }
          if (image.clientWidth > image.naturalWidth * 1.15) {
            image.style.setProperty("--source-image-width", `${image.naturalWidth}px`);
            image.classList.add("figure-panel__image--source-sized");
          }
        });
      };
      let pendingMathMeasure = 0;
      const scheduleMathMeasure = () => {
        cancelAnimationFrame(pendingMathMeasure);
        pendingMathMeasure = requestAnimationFrame(() => {
          markScrollableMath();
          markSourceSizedImages();
        });
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", scheduleMathMeasure, { once: true });
      } else {
        scheduleMathMeasure();
      }
      document.querySelectorAll(".figure-panel__image").forEach((image) => {
        image.addEventListener("load", scheduleMathMeasure);
      });
      window.addEventListener("load", scheduleMathMeasure, { once: true });
      window.addEventListener("resize", scheduleMathMeasure);
    </script>
  </body>
</html>
