---
import { renderRichText } from "../lib/richText";

interface Props {
  id: string;
  title: string;
  caption: string;
  images?: string[];
  source?: string;
}

const { id, title, caption, images = [], source = "" } = Astro.props;
const withBase = (path: string) => {
  if (path.startsWith("http") || path.startsWith("data:") || path.startsWith("#")) {
    return path;
  }
  if (path.startsWith(import.meta.env.BASE_URL)) {
    return path;
  }
  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
};
const resolvedImages = images.map(withBase);
const imageItems = resolvedImages.map((image) => ({
  src: image,
  isPlot: image.includes("/plots/"),
  isInset: /(?:^|[_/-])inset(?:[_./-]|$)/.test(image),
}));
const visualImages = imageItems.filter((image) => !image.isPlot && !image.isInset);
const insetImages = imageItems.filter((image) => image.isInset && !image.isPlot);
const plotImages = imageItems.filter((image) => image.isPlot);
const resolvedSource = source ? withBase(source) : "";
const captionHtml = renderRichText(caption);
---

<figure class="figure-panel" id={id}>
  <figcaption class="figure-panel__caption">
    <strong>{title}</strong>
    {caption ? <span><Fragment set:html={captionHtml} /></span> : null}
  </figcaption>
  {resolvedImages.length > 0 ? (
    <>
      {visualImages.length > 0 ? (
        <div class="figure-panel__media">
          {visualImages.map((image) => (
            <img
              class="figure-panel__image"
              src={image.src}
              alt={`${title} image`}
              loading="lazy"
            />
          ))}
        </div>
      ) : null}
      {insetImages.length > 0 ? (
        <div class="figure-panel__insets">
          {insetImages.map((image) => (
            <img
              class="figure-panel__image figure-panel__image--inset"
              src={image.src}
              alt={`${title} inset`}
              loading="lazy"
            />
          ))}
        </div>
      ) : null}
      {plotImages.length > 0 ? (
        <div class="figure-panel__plots">
          {plotImages.map((image) => (
            <img
              class="figure-panel__image figure-panel__image--plot"
              src={image.src}
              alt={`${title} plot`}
              loading="lazy"
            />
          ))}
        </div>
      ) : null}
    </>
  ) : resolvedSource ? (
    <a class="figure-panel__source" href={resolvedSource}>View source figure</a>
  ) : (
    <p class="figure-panel__pending">Figure asset withheld until the permission record is attached.</p>
  )}
</figure>
