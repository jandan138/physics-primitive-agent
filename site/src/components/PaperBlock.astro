---
import { renderRichText } from "../lib/richText";

interface Props {
  id: string;
  section?: string;
  original: string;
  translation: string;
  translationStatus?: string;
  explanationStatus?: string;
  reproductionStatus?: string;
  sourceNamespace?: string;
  translationProvenance?: string;
}

const {
  id,
  original,
  translation,
  translationStatus = "draft_ai_assisted",
  explanationStatus = "empty",
  reproductionStatus = "not_started",
  sourceNamespace = "cpd_paper_source_text",
  translationProvenance = "not_recorded",
} = Astro.props;

const originalHtml = renderRichText(original);
const translationHtml = renderRichText(translation);
---

<article
  class="paper-block"
  id={id}
  data-source-namespace={sourceNamespace}
  data-translation-status={translationStatus}
  data-explanation-status={explanationStatus}
  data-reproduction-status={reproductionStatus}
  data-translation-provenance={translationProvenance}
>
  <div class="paper-block__original" lang="en"><Fragment set:html={originalHtml} /></div>
  <div class="paper-block__translation" lang="zh-Hans"><Fragment set:html={translationHtml} /></div>
</article>
