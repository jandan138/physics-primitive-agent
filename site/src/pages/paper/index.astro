---
import PaperLayout from "../../layouts/PaperLayout.astro";
import manifest from "../../data/paper-manifest.json";

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
};
const navItems = manifest.sections.map((section) => ({
  href: `paper/${section.slug}/`,
  label: section.title,
}));
const statusLabels: Record<string, string> = {
  draft_ai_assisted: "AI-assisted draft; human review pending",
  user_asserted_permission_record_pending: "User-confirmed permission; evidence record pending",
  pending_user_supplied_record_or_redacted_summary: "Formal permission artifact pending",
  permission_record_pending_bilingual_companion_scaffold_not_cpd_reproduction:
    "Bilingual companion; not a project reproduction claim",
};
const statusLabel = (value: string) => statusLabels[value] ?? value.replaceAll("_", " ");
---

<PaperLayout
  title="CPD Paper Companion"
  description="Bilingual CPD paper companion with source text, draft Chinese translation, and claim-bounded project notes."
  navItems={navItems}
>
  <section class="paper-hero">
    <p class="paper-kicker">User-confirmed permission; record pending</p>
    <h1>Convex Primitive Decomposition for Collision Detection</h1>
    <p>
      English source text with AI-assisted Chinese draft translation. Translation is not yet
      human-reviewed. Full text and paper figures are published from the user-confirmed source
      intake while the formal authorization artifact is being attached. Project reproduction notes
      remain claim-bounded and are added only where dated records exist.
    </p>
    <dl class="paper-meta-grid">
      <div>
        <dt>Source</dt>
        <dd>{manifest.source_version}</dd>
      </div>
      <div>
        <dt>Translation</dt>
        <dd>{statusLabel(manifest.translation_status)}</dd>
      </div>
      <div>
        <dt>Permission</dt>
        <dd>{statusLabel(manifest.permission_status)}</dd>
      </div>
      <div>
        <dt>Claim Boundary</dt>
        <dd>{statusLabel(manifest.claim_boundary)}</dd>
      </div>
    </dl>
  </section>
  <section class="paper-section-list" aria-label="Paper sections">
    {manifest.sections.map((section) => (
      <a class="paper-section-link" href={withBase(`paper/${section.slug}/`)}>
        <span>{section.title}</span>
        <small>{statusLabel(manifest.translation_status)}</small>
      </a>
    ))}
  </section>
</PaperLayout>
